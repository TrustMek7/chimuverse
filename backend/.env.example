# Exclusivo del servidor. Copiar a backend/.env (ignorado por Git).
# No importar este archivo desde el frontend ni usar prefijos VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
APP_URL=http://localhost:5173
SUPABASE_ACCESS_TOKEN=

# Completar cuando se implementen las integraciones correspondientes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# AES-256: 32 bytes en base64, generado por deploy si falta.
# No cambiar esta clave con conexiones Google activas.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Generado por deploy; autentica el scheduler.
CRON_SECRET=

# En producción configurar secretos en Supabase Edge Functions.
# El archivo local no configura automáticamente el entorno de producción.
