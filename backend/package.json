{
  "name": "chimuverse-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "inspect": "node scripts/inspect.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy",
    "deploy": "node scripts/deploy.mjs",
    "test:calendar": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/calendar/index_test.ts",
    "typecheck": "deno check --config supabase/functions/deno.json supabase/functions/calendar/index.ts supabase/functions/youtube/index.ts",
    "deploy:all": "node scripts/deploy.mjs --functions --schedule",
    "backup": "node scripts/preflight.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:youtube": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/youtube/index_test.ts",
    "content:check": "node scripts/build-content-banks.mjs --check",
    "content:build": "node scripts/build-content-banks.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "deno": "^2.9.6",
    "supabase": "^2.58.5"
  }
}
