{
  "name": "chimuverse-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "inspect": "node scripts/inspect.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy",
    "deploy": "node scripts/deploy.mjs",
    "test:calendar": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/calendar/index_test.ts",
    "typecheck": "deno check --config supabase/functions/deno.json supabase/functions/calendar/index.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "deno": "^2.9.6",
    "supabase": "^2.58.5"
  }
}
