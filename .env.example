# Copiar a apps/web/.env.local según docs/getting-started.md
# Variables VITE_ son PUBLICAS: jamás colocar secretos aquí.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_APP_URL=http://localhost:5173

# Configurar en Supabase Edge Function Secrets (NO en frontend):
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_TOKEN_ENCRYPTION_KEY=...
# EMAIL_PROVIDER_CONFIG=... (pendiente)
# Nunca subir tokens de usuarios ni service_role keys.
